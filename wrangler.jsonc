{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "lutterodt",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "lutterodt",
			"environment": "production"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "LUTTERODT_KV",
			"id": "260a65294eda4f0da4b2ca2296de8451"
		}
	],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "LUTTERODT_D1",
			"database_name": "lutterodt-db",
			"database_id": "97d98aca-dd7c-4730-b93d-75f474d2342c",
			"migrations_dir": "migrations"
		}
	]
}
