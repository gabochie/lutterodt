{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "lutterodt",
	"compatibility_date": "2026-07-03",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "lutterodt",
			"environment": "production"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"kv_namespaces": [
		{
			"binding": "LUTTERODT_KV",
			"id": "260a65294eda4f0da4b2ca2296de8451"
		}
	],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "LUTTERODT_D1",
			"database_name": "lutterodt-db",
			"database_id": "97d98aca-dd7c-4730-b93d-75f474d2342c",
			"migrations_dir": "migrations"
		}
	],
	// Preview environment for PRs (workers.dev). One-time setup:
	//   wrangler d1 create lutterodt-db-preview
	//   wrangler kv namespace create LUTTERODT_KV_PREVIEW
	// then replace the placeholder IDs below.
	"env": {
		"preview": {
			"name": "lutterodt-preview",
			"d1_databases": [
				{
					"binding": "LUTTERODT_D1",
					"database_name": "lutterodt-db-preview",
					"database_id": "REPLACE_WITH_PREVIEW_DB_ID",
					"migrations_dir": "migrations"
				}
			],
			"kv_namespaces": [
				{
					"binding": "LUTTERODT_KV",
					"id": "REPLACE_WITH_PREVIEW_KV_ID"
				}
			]
		}
	}
}
