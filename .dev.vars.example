# Copy to .dev.vars and fill in real values. NEVER commit .dev.vars.
# Generate: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

# Admin password for /login (at least 8 characters)
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Discovery search APIs (Brave preferred when set; DuckDuckGo fallback; Google last)
# Get a free key (2,000 queries/month): https://brave.com/search/api/
BRAVE_API_KEY=