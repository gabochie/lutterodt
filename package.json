    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.107.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "cypress": "^13.0.0"
  }
