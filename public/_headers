# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
# The service worker must never be cached long-term so updates propagate.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
# Served as a static asset so the manifest is fetched from the edge, not the Worker.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=0, must-revalidate
